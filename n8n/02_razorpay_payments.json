    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update invoices set status = 'overdue'\nwhere razorpay_invoice_id = $1 and paid_at is null\nreturning id",
        "options": {
          "queryReplacement": "={{ [ $json.razorpay_invoice_id ] }}"
        }
      },
