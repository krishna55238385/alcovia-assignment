                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "invoice_expired"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "ignored"
        }
      },
      "id": "0c8288aa-d641-4c5f-be6d-e66bbe4a375a",
      "name": "Route by event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        720,
        320
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with known as (\n  select id from leads where parent_phone = $2 order by created_at desc limit 1\n), new_lead as (      -- first-time buyer: workshop is a lead source in its own right\n  insert into leads (source, parent_phone, parent_name)\n  select 'workshop', $2, $6 where $2 is not null and not exists (select 1 from known)\n  returning id\n)\ninsert into workshop_bookings (workshop_id, lead_id, razorpay_payment_id, amount, paid_at)\nvalues ($1::bigint, coalesce((select id from known), (select id from new_lead)), $3, $4::numeric, $5::timestamptz)\non conflict (razorpay_payment_id) do nothing\nreturning id",
        "options": {
          "queryReplacement": "={{ [ $json.workshop_id, $json.phone, $json.payment_id, $json.amount_inr, $json.paid_at, $json.payer_name ] }}"
        }
      },
      "id": "b124f3fb-0be2-4b99-b3f0-f54074de99f1",
      "name": "Insert workshop booking",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        960,
        160
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_supabase_pg",
          "name": "Supabase Postgres (n8n)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with inv as (\n  update invoices set status = 'paid', paid_at = coalesce(paid_at, $2::timestamptz)\n  where razorpay_invoice_id = $1\n  returning id\n), renewed as (       -- the trial this invoice renews\n  update enrollments set status = 'renewed'\n  where id = $3::bigint and status = 'active'\n  returning id\n)\nselect (select count(*) from inv)::int as invoices_updated, (select count(*) from renewed)::int as enrollments_renewed",
        "options": {
          "queryReplacement": "={{ [ $json.razorpay_invoice_id, $json.paid_at, $json.renews_enrollment_id ] }}"
        }
      },
      "id": "36273ecc-8151-4dc2-8327-7bee2d683932",
      "name": "Mark invoice paid",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
