{
  "name": "02 Razorpay payments",
  "nodes": [
    {
      "parameters": {
        "content": "## 02 Razorpay → Supabase\nEvents: `payment.captured` (workshop seat, ₹3,999 via payment link with `notes.workshop_id`), `invoice.paid` (program fee; `notes.renews_enrollment_id` marks the trial it renews), `invoice.expired` (→ overdue).\n\n1. HMAC-SHA256 of the **raw** body with `RAZORPAY_WEBHOOK_SECRET` must equal `X-Razorpay-Signature`, else 401.\n2. Writes are keyed on Razorpay IDs, so Razorpay's retries are harmless.\n3. Always answer 200 once stored; failures fall to the error workflow and Razorpay retries.\n\nn8n env: `NODE_FUNCTION_ALLOW_BUILTIN=crypto`.",
        "height": 330,
        "width": 520,
        "color": 7
      },
      "id": "e4bbaf47-e0ae-4556-815b-71e4ea3b28ee",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -80
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "razorpay",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "1dbceb58-651b-4647-a186-005df5b5f343",
      "name": "Razorpay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "c62b8276-2384-42e1-b63e-a5ebdda9fc5d"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst raw = item.binary && item.binary.data\n  ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')\n  : JSON.stringify(item.json.body);\nconst expected = crypto.createHmac('sha256', $env.RAZORPAY_WEBHOOK_SECRET).update(raw).digest('hex');\nconst given = String(headers['x-razorpay-signature'] || '');\nconst valid = given.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected));\n\nconst body = item.json.body && item.json.body.event ? item.json.body : JSON.parse(raw);\nconst payment = body.payload?.payment?.entity;\nconst invoice = body.payload?.invoice?.entity;\nconst iso = s => (s ? new Date(s * 1000).toISOString() : null);\n\nlet route = 'ignore';\nif (body.event === 'payment.captured' && payment && !payment.invoice_id && payment.notes?.workshop_id) route = 'workshop_booking';\nif (body.event === 'invoice.paid' && invoice) route = 'invoice_paid';\nif (body.event === 'invoice.expired' && invoice) route = 'invoice_expired';\n\nreturn [{\n  json: {\n    valid,\n    event: body.event,\n    route,\n    payment_id: payment?.id ?? null,\n    amount_inr: payment ? payment.amount / 100 : null,\n    paid_at: iso(invoice?.paid_at) || iso(payment?.created_at),\n    phone: payment?.contact || invoice?.customer_details?.contact || null,\n    payer_name: payment?.notes?.name || invoice?.customer_details?.name || null,\n    workshop_id: payment?.notes?.workshop_id ?? null,\n    razorpay_invoice_id: invoice?.id ?? null,\n    renews_enrollment_id: invoice?.notes?.renews_enrollment_id ?? null,\n  },\n}];"
      },
      "id": "7423d25e-5759-4e4c-9ac0-2f7207416351",
      "name": "Verify signature + route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "10979707-df8c-452c-ac93-abea4d274f86",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "9c488758-1216-4ec4-ad63-e1183f06316b",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
